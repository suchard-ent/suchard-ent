---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import SuchardHome from '../../components/SuchardHome.astro';
import {locales} from '../../data/credits';
import type {Lang} from '../../data/credits';
import {getHomeMeta} from '../../data/seo-copy';
export function getStaticPaths(){return locales.map(lang=>({params:{lang}}));}
const lang=Astro.params.lang as Lang;
const meta=getHomeMeta(lang);
---
<PortfolioLayout lang={lang} title={meta.title} description={meta.description} ogTitle={meta.ogTitle} ogDescription={meta.ogDescription}>
  <SuchardHome lang={lang}/>
</PortfolioLayout>
