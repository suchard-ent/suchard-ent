---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import SuchardHome from '../../components/SuchardHome.astro';
import type {Lang} from '../../data/credits';
import {getHomeMeta} from '../../data/seo-copy';
export function getStaticPaths(){return [{params:{lang:'ko'}},{params:{lang:'en'}}];}
const lang=Astro.params.lang as Lang;
const meta=getHomeMeta(lang);
---
<PortfolioLayout lang={lang} title={meta.title} description={meta.description}>
  <SuchardHome lang={lang}/>
</PortfolioLayout>
