---
import {locales} from '../data/credits';
import type {Lang} from '../data/credits';
import {getText} from '../data/portfolio-copy';
interface Props {lang:Lang;path?:string;}
const {lang,path=''}=Astro.props;
const t=getText(lang);
const base=import.meta.env.BASE_URL;
const home=base+lang+'/';
const langPath=(l:Lang)=>base+l+'/'+(path?path.replace(/^\/|\/$/g,'')+'/':'');
---
<header class="site-header">
  <a class="wordmark" href={home} aria-label="Suchard home">SUCHARD</a>
  <nav class="primary-nav" aria-label={lang==='ko'?'사이트 탐색':lang==='ja'?'サイト内ナビゲーション':'Site navigation'}>
    <a href={home+'#music'}>{t.nav.music}</a>
    <a href={home+'#about'}>{t.nav.about}</a>
    <a href={home+'#press'}>{t.nav.press}</a>
    <a href={home+'#contact'}>{t.nav.contact}</a>
  </nav>
  <nav class="language-nav" aria-label="Language">
    {locales.map((locale,i)=><>
      {i>0 && <span aria-hidden="true">/</span>}
      <a href={langPath(locale)} hreflang={locale} lang={locale} aria-current={lang===locale?'page':undefined}>{locale.toUpperCase()}</a>
    </>)}
  </nav>
</header>
